# Frontend build-time public API origin. Empty = local Vite proxy.
VITE_API_BASE_URL=
# Backend only; comma-separated exact origins, no paths or wildcards.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PLANNER_TIMEOUT_SECONDS=300
# Limit numerical-library threads on the free service.
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
GDAL_CACHEMAX=16
